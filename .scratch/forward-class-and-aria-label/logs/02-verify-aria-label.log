n343:test('aria-live changes on the host update the inner button', async t => {\n359:test('removing aria-live from the host removes it from the inner button',\n379:test('preact: label content updates reactively', t => {\n412:test('ending spinning keeps a disabled host disabled', async t => {\n451:test('spinning = false on an idle disabled button keeps it disabled',\n469:test('enabling the host while spinning keeps it disabled', async t => {\n500:test('spinning preserves aria-busy updates', async t => {\n515:test('keydown does not synthesize a click', async t => {\n543:test('hydrates an inner button rendered by the app', async t => {\n575:test('hydrates aria-live onto an inner button rendered by the app', t => {\n598:test('forwards a class added to the host to the inner button', async t => {\n608:test('moves a changed host class onto the inner button', async t => {\n621:test('keeps the element classes when the host class changes', async t => {\n634:test('updates the inner button when a Preact class prop changes', t => {\n648:test('hydrates a host class change onto an app-rendered button', t => {\n667:test('hydrates the first host class onto an app-rendered button', t => {\n683:test('moves a host aria-label onto the inner button', async t => {\n686:            aria-label=\"Close\">x</substrate-button>\n689:    t.equal(el.button!.getAttribute('aria-label'), 'Close',\n691:    t.ok(!el.hasAttribute('aria-label'), 'host has no aria-label')\n694:test('moves a late host aria-label onto the inner button', async t => {\n699:    el.setAttribute('aria-label', 'Dismiss')\n700:    t.equal(el.button!.getAttribute('aria-label'), 'Dismiss',\n702:    t.ok(!el.hasAttribute('aria-label'), 'host has no aria-label')\n705:test('ariaLabel property names the inner button', async t => {\n710:    el.ariaLabel = 'Close'\n711:    t.ok(!el.hasAttribute('aria-label'),\n712:        'host has no aria-label while a label is set')\n713:    t.equal(el.button!.getAttribute('aria-label'), 'Close',\n715: