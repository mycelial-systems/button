(html`\n        <${SubstrateButton.TAG} ariaLabel=\"Close\">\n            <button>x</button>\n        <//>\n    `, container)\n    const btn = container.querySelector('button')!\n    t.equal(btn.getAttribute('aria-label'), 'Close',\n        'app-rendered inner button has the label')\n    const host = container.querySelector('substrate-button')!\n    t.ok(!host.hasAttribute('aria-label'), 'host has no aria-label')\n    container.remove()\n})\n\ntest('preact: ariaLabel reads the app-rendered button after a swap', t => {\n    const container = document.createElement('div')\n    document.body.appendChild(container)\n    const view = (key:string) => html`\n        <${SubstrateButton.TAG} ariaLabel=\"Close\">\n            <button key=${key}>x</button>\n        <//>\n    `\n    render(view('a'), container)\n    render(view('b'), container)\n    const el = container.querySelector(\n        SubstrateButton.TAG\n    ) as SubstrateButton\n    t.equal(el.ariaLabel, el.button!.getAttribute('aria-label'),\n        'getter matches the replaced inner button, which has no label')\n    container.remove()\n})\n\ntest('all done', () => {\n    // @ts-expect-error tests\n    window.testsFinished = true\n})","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01VNW87grNmPgYEUENNVC5wN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
