toggleAttribute('autofocus', value)\n    }\n\n    /**\n     * The inner button's accessible name. It lives only on the inner\n     * button: `aria-label` on a host with no role fails axe. An empty\n     * string means no label, because Preact sets a removed property\n     * prop to ''. Before the element has an inner button, this returns\n     * the label it was given.\n     */\n    get ariaLabel ():string|null {\n        const btn = this.button\n        return btn ? btn.getAttribute('aria-label') : this._ariaLabel\n    }\n\n    set ariaLabel (value:string|null) {\n        const label = value || null\n        this._ariaLabel = label\n        if (label === null) {\n            this.button?.removeAttribute('aria-label')\n        } else {\n            this.button?.setAttribute('aria-label', label)\n        }\n        if (this.hasAttribute('aria-label')) {\n            this.removeAttribute('aria-label')\n        }\n    }\n\n    /**\n     * Set attributes on the internal button element.\n     */\n    _setAttribute (name:string, value:boolean|string|null):void {\n        if (value === false) {\n            // false means remove the attribute\n            this._removeAttribute(name)\n            this.button?.removeAttribute(name)\n        } else {\n            if (value === true) {\n                // true means set the attribute with no value\n                return this.button?.setAttribute(name, '')\n            }\n\n            if (value === null) {\n    30\t<!-- nightralph:end -->\n    31\t\n    32\t## Button tests\n    33\t\n    34\tThe public custom-element seam is `substrate-button` and its `button`\n    35\tproperty. Run the browser suite with `esbuild test/index.ts --bundle | tapout`;\n    36\tinspect inner-button attributes through `el.button` rather than rendered HTML.\n    37\t`tapout` always listens on port 8123, so a run fails with `EADDRINUSE`\n    38\twhile another worktree's suite is running. Wait for the port to free and\n    39\trerun; do not kill the other process.\n    40\t\n    41\t## Release versioning\n    42\t\n    43\tFor a release, verify that the manifest version advances the latest published\n    44\tversion recorded in `CHANGELOG.md`. The manifest check is part of `npm test`.\n    45\t\n    46\tThat check, `test/package-version.js`, compares `package.json` against a\n    47\thardcoded version string; it does not read `CHANGELOG.md`. Bump the manifest\n    48\tand that literal together, or `npm test` fails. `CHANGELOG.md` is generated\n    49\tby `auto-changelog` in the `version` script, so never edit it by hand.\n    50\t\n    51\t## Running the browser suite\n    52\t\n    53\t`tapout` serves on a fixed port (8123). If another worktree or project is\n    54\trunning its suite, `tapout` fails with `EADDRINUSE`; wait for that run to\n    55\tfinish instead of killing it.\n    56\t\n    57\tIf npm blocks install scripts, `node_modules/lightningcss-cli/lightningcss`\n    58\tstays a text placeholder and `npm run build-css` fails with\n    59\t`This: command not found`. Run `node postinstall.js` inside\n    60\t`node_modules/lightningcss-cli` to link the platform binary.","is_error":false}]},"parent_tool_use_id":null,"session_id":"a75bbcae-f304-4171-89dc-e53ff3f3fafb","uuid":"cf089c12-7565-4063-b076-d993a96f3c2f","timestamp":"2026-10-30T03:44:15.953Z","tool_use_result":{"stdout":"    render(view(undefined), container)\n    t.ok(!btn.hasAttribute('aria-label'), 'removed prop removes the label')\n    const host = container.querySelector('substrate-button')!\n    t.ok(!host.hasAttribute('aria-label'), 'host has no aria-label')\n    container.remove()\n})\n\ntest('preact: ariaLabel applies to an app-rendered button', t => {\n    const container = document.createElement('div')\n    document.body.appendChild(container)\n    render(html`\n        <${SubstrateButton.TAG} ariaLabel=\"Close\">\n            <button>x</button>\n        <//>\n    `, container)\n    const btn = container.querySelector('button')!\n    t.e