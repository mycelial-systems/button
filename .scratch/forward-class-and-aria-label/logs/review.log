{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ERdMaPEZpgxPrqhrykM8mY","type":"tool_result","content":"diff --git a/AGENTS.md b/AGENTS.md\nindex 5704d90..21314a5 100644\n--- a/AGENTS.md\n+++ b/AGENTS.md\n@@ -34,8 +34,27 @@ the app-rendered hydration path when applicable.\n The public custom-element seam is `substrate-button` and its `button`\n property. Run the browser suite with `esbuild test/index.ts --bundle | tapout`;\n inspect inner-button attributes through `el.button` rather than rendered HTML.\n+`tapout` always listens on port 8123, so a run fails with `EADDRINUSE`\n+while another worktree's suite is running. Wait for the port to free and\n+rerun; do not kill the other process.\n \n ## Release versioning\n \n For a release, verify that the manifest version advances the latest published\n version recorded in `CHANGELOG.md`. The manifest check is part of `npm test`.\n+\n+That check, `test/package-version.js`, compares `package.json` against a\n+hardcoded version string; it does not read `CHANGELOG.md`. Bump the manifest\n+and that literal together, or `npm test` fails. `CHANGELOG.md` is generated\n+by `auto-changelog` in the `version` script, so never edit it by hand.\n+\n+## Running the browser suite\n+\n+`tapout` serves on a fixed port (8123). If another worktree or project is\n+running its suite, `tapout` fails with `EADDRINUSE`; wait for that run to\n+finish instead of killing it.\n+\n+If npm blocks install scripts, `node_modules/lightningcss-cli/lightningcss`\n+stays a text placeholder and `npm run build-css` fails with\n+`This: command not found`. Run `node postinstall.js` inside\n+`node_modules/lightningcss-cli` to link the platform binary.\ndiff --git a/test/index.ts b/test/index.ts\nindex 6287c2e..b60d852 100644\n--- a/test/index.ts\n+++ b/test/index.ts\n@@ -631,6 +631,18 @@ test('keeps the element classes when the host class changes', async t => {\n     t.ok(btn.classList.contains('spinning'), 'keeps spinning')\n })\n \n+test('a host class change never adds an element class', async t => {\n+    document.body.innerHTML += `\n+        <substrate-button id=\"class-owned-add\">go</substrate-button>\n+    `\n+    const el = await waitFor('#class-owned-add') as SubstrateButton\n+    el.setAttribute('class', 'spinning other')\n+    const btn = el.button!\n+    t.ok(!btn.classList.contains('spinning'),\n+        'inner button does not gain spinning')\n+    t.ok(btn.classList.contains('other'), 'inner button gains other')\n+})\n+\n test('updates the inner button when a Preact class prop changes', t => {\n     const container = document.createElement('div')\n     document.body.appendChild(container)\n@@ -639,7 +651,10 @@ test('updates the inner button when a Preact class prop changes', t => {\n     `\n     render(view('a'), container)\n     render(view('b'), container)\n-    const btn = container.querySelector('button')!\n+    const el = container.querySelector(\n+        'substrate-button'\n+    ) as SubstrateButton\n+    const btn = el.button!\n     t.ok(btn.classList.contains('b'), 'inner button has the new class')\n     t.ok(!btn.classList.contains('a'), 'inner button drops the old class')\n     container.remove()\n@@ -657,7 +672,10 @@ test('hydrates a host class change onto an app-rendered button', t => {\n     `\n     render(view('a'), container)\n     render(view('b'), container)\n-    const btn = container.querySelector('button')!\n+    const el = container.querySelector(\n+        'substrate-button'\n+    ) as SubstrateButton\n+    const btn = el.button!\n     t.ok(btn.classList.contains('mine'), 'keeps the app-rendered class')\n     t.ok(btn.classList.contains('b'), 'has the new host class')\n     t.ok(!btn.classList.contains('a'), 'drops the old host class')\n@@ -674,7 +692,10 @@ test('hydrates the first host class onto an app-rendered button', t => {\n             </button>\n         <//>\n     `, container)\n-    const btn = container.querySelector('button')!\n+    const el = container.querySelector(\n+        'substrate-button'\n+    ) as SubstrateButton\n+    const btn = el.button!\n     t.ok(btn.classList.contains('a'), 'has the host class')\n     t.ok(btn.classList.contains('mine'), 'keeps the app-rendered class')\n     container.remove()\n@@ -784,6 +805,7 @@ test('preact: ariaLabel reads the app-rendered button after a swap', t => {\n     ) as SubstrateButton\n     t.equal(el.ariaLabel, el.button!.getAttribute('aria-label'),\n         'getter matches the replaced inner button, which has no label')\n+    t.ok(!el.hasAttribute('aria-label'), 'host has no aria-label')\n     container.remove()\n })\n \n0264b8a nightralph: update ticket checklists\n62a8387 nightralph: 03-docs-and-release-readiness.md done\n50b46f0 Merge branch 'button--forward-class-and-aria-label-03-docs-and-release-readiness' into forward-class-and-aria-label-plan\n587363c nightralph: update ticket checklists\n594dd21 nightralph: record attempt learnings\n54fcc19 docs: note that the version check pins a literal\n00d3f65 nightralph: update ticket checklists\n7fde667 nightralph: 02-verify-aria-label.md done\n38708e8 nightralph: 01-verify-class-following.md done\n6318d38 docs: note lightningcss postinstall gotcha in AGENTS.md\nc706286 test: assert host has no aria-label after app button swap\ndd820f4 Merge branch 'button--forward-class-and-aria-label-01-verify-class-following' into forward-class-and-aria-label-plan\n79d8630 nightralph: update ticket checklists\nc4eaa54 nightralph: record attempt learnings\n250578b docs: note tapout port collisions across worktrees\n53c75c9 test: read Preact class results through el.button\n6553025 test: a host class change never adds an element class\na4460a1 nightralph: start forward-class-and-aria-label","is_error":false}]},"parent_tool_use_id":null,"session_id":"d8f56a77-f92b-445f-9df7-2f5700a387e5","uuid":"e68b4767-10f0-4208-adcb-71f1b4b38b12","timestamp":"2026-10-30T03:43:09.246Z","tool_use_result":{"stdout":"diff --git a/AGENTS.md b/AGE